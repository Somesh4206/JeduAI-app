# JeduAI environment — copy to .env and adjust as needed.
# Everything below matches the built-in defaults; the app runs with just DATABASE_URL set.

# SQLite database (path is resolved relative to prisma/schema.prisma)
DATABASE_URL=file:../db/custom.db

# Join codes required when self-registering elevated roles at sign-up
STAFF_JOIN_CODE=JEDU-STAFF
ADMIN_JOIN_CODE=JEDU-ADMIN

# AI features (tutor, translation, OCR, ASR, TTS) run server-side via
# z-ai-web-dev-sdk. Credentials never ship to the client.
